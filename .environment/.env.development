# Prefix env variable names with "DOMO_" to allow client-side
# visibility to variables
DOMO_SUPPORT='https://www.domo.com/business-apps/app-dev-framework'

# Dev-only bypass token — injected as x-domo-developer-token header.
# Intentionally OFF: local dev runs the real magic-link + OAuth flow.
# Must stay in sync with DEV_TOKEN in huckleberry-server .env.
# DOMO_DEV_TOKEN=huckleberry-dev-bypass
