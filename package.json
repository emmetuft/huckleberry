    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.1",
    "vite-express": "^0.19.0",
    "vite-plugin-checker": "^0.8.0",
