{
  "name": "huckleberry-ai",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "start": "vite",
    "build": "yarn run-checks && vite build",
    "preview": "yarn build && vite preview",
    "run-checks": "yarn format && yarn lint && yarn lint:css && yarn test:ci",
    "format": "prettier --ignore-unknown --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests --no-color",
    "storybook": "storybook dev -p 6006",
    "generate": "da generate"
  },
  "moduleDirectories": [
    "node_modules",
    "src"
  ],
  "lint-staged": {
    "*": [
      "yarn run-checks",
      "git update-index --again"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.9",
    "@appteam6/domoapps.js": "^4.2.3",
    "@chenglou/pretext": "^0.0.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/view": "^6.38.6",
    "@dagrejs/dagre": "^3.0.0",
    "@domoinc/toolkit": "^2.3.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.2.7",
    "@types/d3": "^7.4.3",
    "@types/js-cookie": "^3.0.6",
    "@types/three": "^0.181.0",
    "@uiw/react-codemirror": "^4.25.2",
    "@xyflow/react": "^12.8.1",
    "ag-grid-react": "^35.2.1",
    "ai": "^6.0.33",
    "antd": "^5.26.4",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.0",
    "js-cookie": "^3.0.5",
    "mammoth": "^1.12.0",
    "neo4j-driver": "^6.0.1",
    "p-limit": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "ryuu.js": "^4.4.7",
    "shaders": "^2.1.14",
    "sonner": "^2.0.7",
    "three-spritetext": "^1.10.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@domoinc/da": "2.0.0",
    "@domoinc/ryuu-proxy": "^4.4.0",
    "@eslint/js": "^9.10.0",
    "@storybook/addon-essentials": "^8.3.2",
    "@storybook/addon-interactions": "^8.3.2",
    "@storybook/addon-links": "^8.3.2",
    "@storybook/addon-onboarding": "^8.3.2",
    "@storybook/blocks": "^8.3.2",
    "@storybook/builder-vite": "^8.3.2",
    "@storybook/react": "^8.3.2",
    "@storybook/react-vite": "^8.3.2",
    "@storybook/test": "^8.3.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-storybook": "^0.8.0",
    "express": "^4.21.0",
    "get-port": "^7.1.0",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
